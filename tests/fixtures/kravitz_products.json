ית של XBOX. הקונסולה מגיעה עם מנוי Xbox Game Pass Ultimate לשלושה חודשים. ישנו צורך בחשבון מיקרוסופט על מנת להשתמש במנוי. XBOX SERIES S כוללת שלט אלחוטי, כבל HDMI מהיר.באמצעות SSD אישית ושבב SOC חדשני הקונסולה מספקת מהירות משחק של 120FPS.XBOX SERIES S היא קונסולת המשחקים הראשונה שמשולב בה טכנולוגיית DOLBI לתצוגה ואודיו משופר.\u003c\/p\u003e\n\u003cp style=\"direction: rtl;\"\u003e\u003cstrong\u003eשימו לב! לצורך קבלת מנוי לשלושה חודשים מתנה -  יש להירשם לשירות Xbox Game Pass באתר הרשמי ולמסור פרטי אשראי - ניתן לבטל לאחר ניצול המתנה. \u003c\/strong\u003e\u003c\/p\u003e\n\u003cp style=\"direction: rtl;\"\u003e \u003c\/p\u003e","published_at":"2026-09-22T11:41:02+03:00","created_at":"2023-11-29T10:17:21+02:00","updated_at":"2026-11-12T23:32:36+02:00","vendor":"Xbox","product_type":"קונסולות","tags":["קונסולות Xbox"],"variants":[{"id":47256387354920,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"10060581","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"1899.00","grams":0,"compare_at_price":null,"position":1,"product_id":8800680706344,"created_at":"2023-11-29T10:17:21+02:00","updated_at":"2026-11-12T23:32:36+02:00"}],"images":[{"id":45031732609320,"created_at":"2024-01-15T14:41:30+02:00","position":1,"updated_at":"2024-01-15T14:42:09+02:00","product_id":8800680706344,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/0197\/9176\/files\/10060581.jpg?v=1705322529","width":1200,"height":1200},{"id":44683449729320,"created_at":"2023-11-29T10:17:21+02:00","position":2,"updated_at":"2024-01-15T14:42:09+02:00","product_id":8800680706344,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/0197\/9176\/files\/100605811.jpg?v=1705322529","width":1200,"height":1172}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]}]}